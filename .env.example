# ==============================================================================
# 高校实习全过程管理系统 - 环境变量示例配置 (.env.example)
# 说明：本地开发可将本文件复制为 .env 并填入实际值，由运维或系统环境变量注入
# ==============================================================================

# 数据库配置 (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=internship_db
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password_here

# JWT 安全密钥配置 (建议至少 256 位，即 32 字符以上随机安全码)
JWT_SECRET_KEY=your_secure_jwt_secret_key_at_least_256_bits_length_here
JWT_EXPIRATION_SECONDS=7200

# 附件物理存储配置
UPLOAD_BASE_PATH=D:/devlop/IDEA/college-internship-management-system/uploads/
UPLOAD_MAX_SIZE_MB=20
