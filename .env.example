# ==============================================================================
# Docker 演练环境变量模板 (.env.example)
# 请复制为 .env 使用，严禁提交包含真实敏感生产密码的 .env 文件至仓库
# ==============================================================================

# Docker 映射端口配置
DOCKER_DB_PORT=3308
DOCKER_BACKEND_PORT=8088
DOCKER_FRONTEND_PORT=8888

# 数据库安全凭证配置 (仅供本地演练)
DB_ROOT_PASSWORD=your_root_password_here
DB_USER=internship_test
DB_PASSWORD=your_test_password_here
